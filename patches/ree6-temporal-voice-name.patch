+    private String resolveTemporalVoiceName(String template, Member member, long channelNumber) {
+        String displayName = member.getEffectiveName().replace('\n', ' ').replace('\r', ' ').trim();
+        String username = member.getUser().getName().replace('\n', ' ').replace('\r', ' ').trim();
+
+        String resolvedName = template
+                .replace("{displayName}", displayName)
+                .replace("{username}", username)
+                .replace("{number}", String.valueOf(channelNumber))
+                .replace("%s", String.valueOf(channelNumber))
+                .trim();
+
+        if (resolvedName.isBlank()) {
+            resolvedName = "Temporal VC #" + channelNumber;
+        }
+
+        if (resolvedName.codePointCount(0, resolvedName.length()) > 100) {
+            resolvedName = resolvedName.substring(0, resolvedName.offsetByCodePoints(0, 100));
+        }
+
+        return resolvedName;
+    }
